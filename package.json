{
  "name": "paste-perfect",
  "version": "2.9.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "npm run start",
    "serve:test": "ng serve --configuration=test --no-hmr",
    "serve:prod": "ng serve --configuration=production --no-hmr",
    "build-preview": "node scripts/build.mjs preview",
    "build-prod": "node scripts/build.mjs production",
    "build-docker": "node scripts/build.mjs docker",
    "lint:check": "ng lint",
    "lint:fix": "ng lint --fix",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,html,scss}\" \"config/**/*.{ts,yml}\" \"scripts/**/*.mjs\" \".github/**/*.{yml,cjs}\" \"*.{json,md}\" \"docs/*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,js,json,html,scss}\" \"config/**/*.{ts,yml}\" \"scripts/**/*.mjs\" \".github/**/*.{yml,cjs}\" \"*.{json,md}\" \"docs/*.md\"",
    "test": "npm run test:unit:coverage && npm run test:snapshots",
    "test:unit": "ng test --watch=false",
    "test:unit:watch": "ng test --watch",
    "test:unit:coverage": "ng test --watch=false --coverage",
    "test:unit:ci": "ng test --watch=false",
    "test:snapshots": "node scripts/playwright-docker.mjs",
    "test:snapshots:ci": "playwright test --config=config/tests/playwright.config.ts",
    "test:snapshots:ui": "node scripts/playwright-docker.mjs --ui",
    "test:snapshots:update": "node scripts/playwright-docker.mjs --update-snapshots",
    "prepare": "husky",
    "test:automation": "node --test scripts/*.test.mjs",
    "test:snapshots:local": "playwright test --config=config/tests/playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-gherkin": "^4.0.0",
    "prettier-plugin-java": "^2.10.3",
    "prettier-plugin-nginx": "^2.0.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-toml": "^2.0.6",
    "prismjs": "^1.30.0",
    "rxjs": "^7.8.2",
    "sql-formatter": "^15.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.4",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "baseline-browser-mapping": "^2.11.22",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  }
}
