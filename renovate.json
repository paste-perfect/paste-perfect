{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":configMigration",
    ":enableVulnerabilityAlerts",
    "group:allNonMajor",
    "replacements:all",
    "security:minimumReleaseAgeNpm"
  ],
  "baseBranchPatterns": ["dev"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "ignoreUnstable": true,
  "rangeStrategy": "bump",
  "automerge": false,
  "postUpdateOptions": ["npmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Framework packages must migrate together",
      "groupName": "angular framework",
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@schematics/**",
        "angular-eslint",
        "@angular-eslint/**",
        "@openng/optimus-ui",
        "@openng/optimus-ui-*",
        "typescript"
      ],
      "groupSlug": "angular-framework"
    },
    {
      "description": "Angular 22 supports TypeScript 6.0",
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=6.0.0 <6.1.0"
    },
    {
      "description": "Angular build currently requires Vitest 4",
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "allowedVersions": "<5"
    },
    {
      "description": "Node type definitions follow the runtime",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Playwright Docker version derives from the installed test package",
      "matchPackageNames": ["@playwright/test"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
